MODEL_VERIFIER=gpt-oss
MODEL_ASSISTANT=qwen3
MODEL_STT=gemma-small
MODEL_FALLBACK=service       # NRP virtual model used when a role's model fails
LOG_LEVEL=info
VITE_API_URL=http://localhost:4000
